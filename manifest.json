{
  "manifest_version": 3,
  "name": "TEOS Browser - Ayman.Teos",
  "version": "1.0.0",
  "description": "Royal Gateway for .teos domains - Ayman.Teos",
  "permissions": ["webRequest", "webRequestBlocking", "declarativeNetRequest"],
  "host_permissions": ["*://*.teos/*"],
  "background": {
    "service_worker": "background.js"
  }
}
