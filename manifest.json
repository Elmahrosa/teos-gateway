{
  "manifest_version": 3,
  "name": "TEOS Gateway - المتصفح المصري WEB4",
  "version": "1.0.0",
  "description": "افتح اي دومين .teos مباشرة من كروم - WEB4",
  "permissions": ["webRequest", "tabs", "webNavigation"],
  "host_permissions": ["*://*.teos/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "TEOS Gateway WEB4" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
